{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dolby OptiView Real-time Streaming ABR Ladders Cluster API",
    "version": "2026.05"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cluster",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Cluster",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.millicast.com/api/cluster"
          },
          "docs": "Return the publish/subscribe URLs for the region the account is provisioned in."
        }
      ]
    }
  ],
  "bundled": true
}