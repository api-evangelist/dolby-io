{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dolby OptiView Real-time Streaming ABR Ladders Webhook API",
    "version": "2026.05"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhook",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.millicast.com/api/webhooks"
          },
          "docs": "List Webhooks"
        },
        {
          "info": {
            "name": "Create Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.millicast.com/api/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a webhook URL to receive feeds, recordings, thumbnails, transcoder, and viewer-connection events. Payloads are signed with HMAC-SHA1 in the X-Millicast-Signature header."
        },
        {
          "info": {
            "name": "Delete Webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.millicast.com/api/webhooks/:webhookID",
            "params": [
              {
                "name": "webhookID",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Webhook"
        }
      ]
    }
  ],
  "bundled": true
}